#!/bin/bash
set -euo pipefail

SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
USER_SYSTEMD_DIR="${XDG_CONFIG_HOME:-$HOME/.config}/systemd/user"
UNIT="renewcerts.timer"

echo "📁 Ensuring user systemd directory exists: $USER_SYSTEMD_DIR"
mkdir -p "$USER_SYSTEMD_DIR"

echo "📋 Copying renewcerts.service and renewcerts.timer to $USER_SYSTEMD_DIR..."
cp "$SCRIPT_DIR/renewcerts.service" "$USER_SYSTEMD_DIR/"
cp "$SCRIPT_DIR/renewcerts.timer" "$USER_SYSTEMD_DIR/"

echo "⏳ Enabling lingering for user: $USER..."
if loginctl enable-linger "$USER" 2>/dev/null; then
  echo "✅ Linger enabled."
elif command -v sudo >/dev/null 2>&1 && sudo loginctl enable-linger "$USER"; then
  echo "✅ Linger enabled with sudo."
else
  echo "⚠️  Could not enable linger automatically. Please run: sudo loginctl enable-linger $USER"
fi

echo "🔄 Reloading user systemd daemon..."
systemctl --user daemon-reload

if systemctl --user is-active --quiet "$UNIT"; then
  echo "Unit '$UNIT' is active — restarting."
  systemctl --user restart "$UNIT"
else
  echo "Unit '$UNIT' is not active — enabling and starting now."
  systemctl --user enable --now "$UNIT"
fi

echo "✅ User timer installation complete."
echo ""
systemctl --user list-timers "$UNIT" || true
